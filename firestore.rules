rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isInstitutionalUser() {
      return isAuthenticated() &&
        request.auth.token.email != null &&
        (
          request.auth.token.email.matches('.*@educacao\\.jundiai\\.sp\\.gov\\.br$') ||
          request.auth.token.email == 'emebjfreitas@jundiai.sp.gov.br'
        );
    }

    // Classes collection (1 document per class, <1MB each)
    match /school_classes_2027/{classId} {
      allow read: if true;
      allow create, update: if request.resource.data.id == classId &&
        request.resource.data.students is list &&
        request.resource.data.students.size() <= 100;
      allow delete: if isInstitutionalUser();
    }

    // School metadata & configuration (users, attendance window, cloud links, discovered caches)
    match /school_meta_2027/{docId} {
      allow read: if true;
      allow create, update: if docId in ['state', 'config'] &&
        request.resource.data.keys().size() <= 20;
      allow delete: if isInstitutionalUser();
    }
  }
}
